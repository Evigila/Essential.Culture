<Window
  x:Class="Arkheide.Essential.Culture.Demo.WinUI3.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:culture="using:Arkheide.Essential.Culture"
  Title="{culture:Localize Key=App_Title}"
>
  <Grid x:Name="Root" Background="#F3F4F6">
    <Border
      Width="800"
      Padding="56"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Background="White"
      BorderBrush="#E5E7EB"
      BorderThickness="1"
      CornerRadius="18"
    >
      <StackPanel>
        <TextBlock
          Text="{culture:Localize Key=App_Title}"
          FontFamily="Segoe UI"
          FontSize="34"
          FontWeight="SemiBold"
          Foreground="#111827"
        />
        <TextBlock
          Text="{culture:Localize Key=Greeting}"
          culture:Localize.Argument0="{x:Bind ProductName, Mode=OneWay}"
          FontFamily="Segoe UI"
          Margin="0,24,0,0"
          FontSize="24"
          FontWeight="SemiBold"
          Foreground="#1F2937"
        />
        <TextBlock
          Text="{culture:Localize Key=Description}"
          FontFamily="Segoe UI"
          Margin="0,12,0,0"
          FontSize="16"
          LineHeight="26"
          Foreground="#4B5563"
          TextWrapping="Wrap"
        />
        <TextBlock
          x:Name="CurrentCultureText"
          Text="{culture:Localize Key=Current_Culture}"
          culture:Localize.Argument0="{x:Bind CurrentCulture, Mode=OneWay}"
          FontFamily="Segoe UI"
          Margin="0,20,0,0"
          FontSize="14"
          Foreground="#6B7280"
        />
        <StackPanel Margin="0,32,0,0" Orientation="Horizontal" Spacing="12">
          <Button
            Content="{culture:Localize Key=Action_SwitchLanguage}"
            Click="SwitchLanguage_Click"
            FontFamily="Segoe UI"
            MinWidth="180"
            Height="44"
            Padding="20,0"
            FontSize="14"
            FontWeight="SemiBold"
          />
          <Button
            Content="{culture:Localize Key=Action_ShowGreeting}"
            Click="ShowGreeting_Click"
            FontFamily="Segoe UI"
            MinWidth="180"
            Height="44"
            Padding="20,0"
            FontSize="14"
            FontWeight="SemiBold"
          />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
