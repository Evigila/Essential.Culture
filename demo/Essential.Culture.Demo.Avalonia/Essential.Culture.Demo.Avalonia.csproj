<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ArkheideSystem.Essential.Culture.Demo.Avalonia</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\Culture.json" Link="Culture.json" />
    <None Include="..\Culture.json" Link="Culture.json" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Arkheide.Essential.Culture.Avalonia" Version="$(VersionPrefix)" Condition="'$(UseLocalCulture)' != 'true'" />
    <ProjectReference Include="..\..\src\Essential.Culture.Avalonia\Essential.Culture.Avalonia.csproj" Condition="'$(UseLocalCulture)' == 'true'" />
    <ProjectReference Include="..\..\src\Essential.Culture.Generator\Essential.Culture.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" Condition="'$(UseLocalCulture)' == 'true'" />
  </ItemGroup>
</Project>
