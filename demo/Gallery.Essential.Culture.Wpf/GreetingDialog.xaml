<Window
  x:Class="ArkheideSystem.Essential.Culture.Demo.Wpf.GreetingDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:culture="clr-namespace:ArkheideSystem.Essential.Culture"
  Title="{culture:Localize Key=App_Title}"
  Width="440"
  SizeToContent="Height"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  WindowStartupLocation="CenterOwner"
  Background="White"
  FontFamily="Segoe UI"
>
  <StackPanel Margin="32">
    <TextBlock
      Text="{culture:Localize KeyBinding={Binding GreetingKey}}"
      FontSize="20"
      FontWeight="SemiBold"
      Foreground="#1F2937"
      TextWrapping="Wrap"
    />
    <Button
      Content="{culture:Localize Key=Action_Close}"
      Click="Close_Click"
      MinWidth="120"
      Height="40"
      Margin="0,24,0,0"
      Padding="18,0"
      HorizontalAlignment="Right"
      FontSize="14"
    />
  </StackPanel>
</Window>
