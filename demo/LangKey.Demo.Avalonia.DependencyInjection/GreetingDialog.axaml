<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:keys="using:ArkheideSystem.LangKey.Demo.Shared"
        x:Class="ArkheideSystem.LangKey.Demo.AvaloniaDi.GreetingDialog"
        Title="{x:Static keys:LangKey.App_Title}"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="White"
        FontFamily="Segoe UI">
  <StackPanel Margin="32" Spacing="24">
    <TextBlock Text="{x:Static keys:LangKey.Greeting}"
               FontSize="20"
               FontWeight="SemiBold"
               Foreground="#1F2937"
               TextWrapping="Wrap" />
    <Button Content="{x:Static keys:LangKey.Action_Close}"
            Click="Close_Click"
            MinWidth="120"
            Height="40"
            Padding="18,0"
            FontSize="14"
            HorizontalAlignment="Right" />
  </StackPanel>
</Window>
