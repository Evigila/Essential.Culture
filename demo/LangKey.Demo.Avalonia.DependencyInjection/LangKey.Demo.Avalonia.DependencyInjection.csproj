<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <LangKeyNamespace>ArkheideSystem.LangKey.Demo.Shared</LangKeyNamespace>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\LangKey.json" Link="LangKey.json" />
    <None Include="..\LangKey.json" Link="LangKey.json" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\Shared\DemoCultureSource.cs" Link="Shared\DemoCultureSource.cs" />
    <Compile Include="..\Shared\DelegateCommand.cs" Link="Shared\DelegateCommand.cs" />
    <Compile Include="..\Shared\LocalizedDemoViewModel.cs" Link="Shared\LocalizedDemoViewModel.cs" />
    <CompilerVisibleProperty Include="LangKeyNamespace" />
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <ProjectReference Include="..\..\src\LangKey.DependencyInjection\LangKey.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\src\LangKey.Generator\LangKey.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
