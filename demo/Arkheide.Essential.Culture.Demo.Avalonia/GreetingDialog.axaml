<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:culture="using:Arkheide.Essential.Culture"
        xmlns:local="using:Arkheide.Essential.Culture.Demo.Avalonia"
        x:Class="Arkheide.Essential.Culture.Demo.Avalonia.GreetingDialog"
        x:DataType="local:GreetingDialog"
        Title="{culture:Localize App_Title}"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="White"
        FontFamily="Segoe UI">
  <StackPanel Margin="32" Spacing="24">
    <TextBlock FontSize="20"
               FontWeight="SemiBold"
               Foreground="#1F2937"
               TextWrapping="Wrap">
      <TextBlock.Text>
        <culture:Localize Key="Greeting">
          <Binding Path="ProductName" />
        </culture:Localize>
      </TextBlock.Text>
    </TextBlock>
    <Button Content="{culture:Localize Action_Close}"
            Click="Close_Click"
            MinWidth="120"
            Height="40"
            Padding="18,0"
            FontSize="14"
            HorizontalAlignment="Right" />
  </StackPanel>
</Window>
