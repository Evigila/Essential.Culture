<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Arkheide.Essential.Culture.WinUI</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Arkheide.Essential.Culture.WinUI</PackageId>
    <Description>Strongly typed WinUI 3 XAML localization for Arkheide.Essential.Culture.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <ProjectReference Include="..\Arkheide.Essential.Culture\Arkheide.Essential.Culture.csproj" PrivateAssets="none" />
  </ItemGroup>
</Project>
