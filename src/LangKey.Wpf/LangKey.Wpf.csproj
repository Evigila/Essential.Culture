<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ArkheideSystem.LangKey.Wpf</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>ArkheideSystem.LangKey.Wpf</PackageId>
    <Description>Automatic WPF visual-tree localization for the LangKey runtime.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.8" />
    <ProjectReference Include="..\LangKey.DependencyInjection\LangKey.DependencyInjection.csproj" />
  </ItemGroup>
</Project>
