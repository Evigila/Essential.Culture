<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ArkheideSystem.LangKey.WinUI</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>ArkheideSystem.LangKey.WinUI.Runtime</PackageId>
    <Description>WinUI 3 visual-tree localization adapter for the LangKey runtime.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <ProjectReference Include="..\LangKey\LangKey.csproj" PrivateAssets="none" />
  </ItemGroup>
</Project>
