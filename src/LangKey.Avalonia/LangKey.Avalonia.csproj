<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ArkheideSystem.LangKey.Avalonia</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>ArkheideSystem.LangKey.Avalonia</PackageId>
    <Description>Automatic Avalonia localization with dependency injection for LangKey.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.8" />
    <ProjectReference Include="..\LangKey.Avalonia.Runtime\LangKey.Avalonia.Runtime.csproj" PrivateAssets="none" />
    <ProjectReference Include="..\LangKey.DependencyInjection\LangKey.DependencyInjection.csproj" PrivateAssets="none" />
  </ItemGroup>
</Project>
