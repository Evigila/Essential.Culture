<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ArkheideSystem.LangKey.Wpf</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>ArkheideSystem.LangKey.Wpf.Runtime</PackageId>
    <Description>DI-free WPF visual-tree localization for the LangKey runtime.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LangKey\LangKey.csproj" PrivateAssets="none" />
  </ItemGroup>
</Project>
