<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ArkheideSystem.LangKey.Avalonia</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>ArkheideSystem.LangKey.Avalonia.Runtime</PackageId>
    <Description>Avalonia visual-tree localization primitives for the LangKey runtime.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <ProjectReference Include="..\LangKey\LangKey.csproj" PrivateAssets="none" />
  </ItemGroup>
</Project>
